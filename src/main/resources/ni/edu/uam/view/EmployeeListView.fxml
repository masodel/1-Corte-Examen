<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam._corteexamen.controller.EmployeeListController"
      spacing="16.0" styleClass="card" VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label text="Plantilla de Empleados" styleClass="card-title" />
            <Label text="Listado del personal registrado en la organización." styleClass="card-subtitle" />
        </VBox>
        <Label fx:id="lblTotalRecords" text="Total: 0 registros" styleClass="card-subtitle" style="-fx-font-weight: bold;" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="Buscar por nombre, apellido o cargo..." HBox.hgrow="ALWAYS" />
        <Button text="Ir a Registro" onAction="#handleGoToForm" styleClass="btn-primary" />
    </HBox>

    <TableView fx:id="tblEmployees" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="Código" prefWidth="110.0" />
            <TableColumn fx:id="colFirstName" text="Nombres" prefWidth="170.0" />
            <TableColumn fx:id="colLastName" text="Apellidos" prefWidth="170.0" />
            <TableColumn fx:id="colPosition" text="Cargo" prefWidth="160.0" />
            <TableColumn fx:id="colSalary" text="Salario ($)" prefWidth="130.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>